+        if create_target is None:
+            return model_class(*args, **kwargs)
+        return create_target.create(*args, **kwargs)
+
+    @classmethod
+    def _create(cls, model_class, *args, **kwargs):
+        return cls._call_create(model_class, *args, **kwargs)
